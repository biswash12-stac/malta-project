NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/malta_project
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required in production, at least 32 characters. Protects stored 2FA codes.
# TWO_FACTOR_SECRET=

# Email for password resets and 2FA codes. Required in production.
# In development, leave SMTP_HOST empty to print emails to the log instead of sending.
# Gmail: smtp.gmail.com, port 587, and a Google "app password" as SMTP_PASS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Required in production. The OAuth client ID from Google Cloud Console.
# GOOGLE_CLIENT_ID=

# Required in production. From the Cloudinary dashboard. Never expose the API secret.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Required in production: how many proxies sit in front of the API.
# 0 if clients connect directly, otherwise check your host's documentation.
# TRUST_PROXY_HOPS=1

# Production only: parent domain shared by the site and the API
# COOKIE_DOMAIN=.example.com

# Only read by npm run seed:admin. The password must be at least 12 characters.
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
